{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/send-confirmation",
      "schedule": "17 3 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/grader",
      "destination": "https://unirab-grader-eta.vercel.app/grader"
    },
    {
      "source": "/grader/:path*",
      "destination": "https://unirab-grader-eta.vercel.app/grader/:path*"
    }
  ]
}